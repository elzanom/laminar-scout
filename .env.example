# ============================================================
# laminar-scout — environment variables
# Copy this file to `.env` and fill in real values.
# ============================================================

# ---------- REQUIRED ----------
# Helius API key (https://helius.dev)
HELIUS_API_KEY=your_helius_key_here

# Helius RPC endpoint (must include API key as query string)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Shared secret used to verify HMAC signature on incoming Helius webhook POSTs.
# Generate a long random string, e.g. `openssl rand -hex 32`.
HELIUS_WEBHOOK_SECRET=replace_with_long_random_secret

# ---------- OPTIONAL ----------
# Birdeye API key — used as fallback for token price/volume metrics.
# Leave blank to fall back to Jupiter public API.
BIRDEYE_API_KEY=

# ---------- MODE / RUNTIME ----------
# Logger threshold: debug | info | warn | error
LOG_LEVEL=info

# Port the webhook receiver listens on (src/collector/helius-stream.js)
WEBHOOK_PORT=3001

# Scout is read-only and never executes on-chain transactions, so DRY_RUN has
# no functional effect. The flag is honored for parity with the Laminar agent
# and will log a warning at startup if set to false.
DRY_RUN=true
