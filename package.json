{
  "name": "laminar-scout",
  "version": "0.1.0",
  "description": "Self-discovering wallet tracker + data pipeline for Meteora DLMM top LP wallets. Feeds training data + signals to Laminar.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "webhook": "node src/collector/helius-stream.js",
    "dashboard": "node scripts/dashboard.js",
    "backfill": "node scripts/backfill.js",
    "seed": "node scripts/seed.js",
    "start:all": "node scripts/start.js",
    "stop:all": "node scripts/stop.js",
    "status": "node scripts/status.js",
    "rebuild": "node scripts/rebuild-all.js",
    "stats": "node scripts/dataset-stats.js",
    "export": "node scripts/export-dataset.js",
    "build-dataset": "node scripts/build-dataset.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:logs": "pm2 logs laminar-scout",
    "pm2:restart": "pm2 restart laminar-scout",
    "pm2:stop": "pm2 stop laminar-scout",
    "smoke:db": "node scripts/smoke-db.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "^1.9.4",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0",
    "better-sqlite3": "^12.11.1",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonrepair": "^3.7.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "pm2": "^7.0.1"
  }
}
